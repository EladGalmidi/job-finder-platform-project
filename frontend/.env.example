# Which transport the API layer uses.
#   mock -> in-memory MockTransport backed by MockDb (no network)
#   live -> AxiosTransport against VITE_API_BASE_URL
VITE_API_MODE=mock

# Base URL used when VITE_API_MODE=live
VITE_API_BASE_URL=http://localhost:8000/api

# Artificial latency multiplier for the mock transport (1 = default timings, 0 = instant)
VITE_MOCK_LATENCY=1
