server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # React Router owns the URL space, so any path the filesystem does not have
    # must return index.html rather than 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # The trailing slash on proxy_pass is load-bearing: with it, /api/auth/login
    # arrives at the backend as /auth/login, which is how the routes are
    # registered. Without it the prefix passes through and every request 404s.
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
