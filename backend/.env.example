# Copy to .env and fill in. .env is gitignored and must never be committed.

NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Matches docker-compose.yml. Port 5433, not 5432: a native PostgreSQL may already
# hold 5432 on Windows. Change the password before this runs anywhere real.
DATABASE_URL=postgres://jobmatch:jobmatch@localhost:5433/jobmatch

# Signs session cookies. Minimum 32 characters; the server refuses to start below that.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-generated-secret-at-least-32-chars

# The frontend origin allowed to send credentialed requests.
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info

GEMINI_API_KEY=
